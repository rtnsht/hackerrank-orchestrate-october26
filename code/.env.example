# =====================================================================================================================
# Ghost Data Still Exists - Mastra deletion-audit agent: sample environment file
# ---------------------------------------------------------------------------------------------------------------------
# Copy to code/.env (git-ignored) and fill in what you need:   cp .env.example .env
# `npm start`, `npm run samples`, `npm run evaluate` and `npm run llm-smoke` load code/.env automatically
# (or the file named by AUDIT_ENV_FILE). Variables already exported in your shell take precedence over this file.
#
# Every value is optional. With no key at all, every agent falls back to its deterministic counterpart and the
# audit still produces output.csv. NEVER commit real keys.
#
# Precedence for each agent setting:   AUDIT_<AGENT>_<SETTING>   >   shared AUDIT_<SETTING>   >   built-in default
# Agents:   INTENT  = deletion-intent-agent   (is this request a deletion? multilingual)
#           VISION  = evidence-vision-agent   (reads screenshots / PDFs into structured records)
#           REVIEW  = audit-reviewer-agent    (critiques each finished plan; notes go to the trace only)
# =====================================================================================================================


# ---------------------------------------------------------------------------------------------------------------------
# 1. Provider keys (shared). An agent uses the key whose provider matches the prefix of ITS model id,
#    e.g. AUDIT_INTENT_MODEL=openai/gpt-5-mini uses OPENAI_API_KEY. Leave unused ones empty.
# ---------------------------------------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=


# ---------------------------------------------------------------------------------------------------------------------
# 2. Global switches and shared defaults
# ---------------------------------------------------------------------------------------------------------------------
# auto = run each agent whose credentials exist | off = force the deterministic path for every agent
AUDIT_LLM=auto
# Shared default model for agents that do not set their own AUDIT_<AGENT>_MODEL (leave empty for per-agent defaults)
AUDIT_MODEL=
# Shared OpenAI-compatible endpoint for agents that do not set their own (e.g. a corporate gateway / proxy)
AUDIT_BASE_URL=
# Shared generation settings (agents may override)
AUDIT_TEMPERATURE=0
AUDIT_MAX_OUTPUT_TOKENS=


# ---------------------------------------------------------------------------------------------------------------------
# 3. Intent agent  (deletion-intent-agent; one call per request; rules always cross-check it)
# ---------------------------------------------------------------------------------------------------------------------
# auto | true | false        (auto/true still need credentials)
AUDIT_INTENT_ENABLED=auto
# Mastra model-router id "provider/model"
AUDIT_INTENT_MODEL=anthropic/claude-haiku-5-5
# Optional key used only by this agent (overrides the provider key above)
AUDIT_INTENT_API_KEY=
# Optional endpoint used only by this agent (OpenAI-compatible URL, e.g. a local/self-hosted model server)
AUDIT_INTENT_BASE_URL=
AUDIT_INTENT_TEMPERATURE=0
AUDIT_INTENT_MAX_OUTPUT_TOKENS=300
# Optional price override for the usage report (USD per 1M tokens); built-in prices cover the default models
AUDIT_INTENT_PRICE_INPUT_PER_MTOK=
AUDIT_INTENT_PRICE_OUTPUT_PER_MTOK=


# ---------------------------------------------------------------------------------------------------------------------
# 4. Vision agent  (evidence-vision-agent; one call per screenshot / PDF; results cached per file hash + model)
#    Must be a multimodal (image-capable) model for screenshots.
# ---------------------------------------------------------------------------------------------------------------------
AUDIT_VISION_ENABLED=auto
AUDIT_VISION_MODEL=anthropic/claude-sonnet-5-5
AUDIT_VISION_API_KEY=
AUDIT_VISION_BASE_URL=
AUDIT_VISION_TEMPERATURE=0
AUDIT_VISION_MAX_OUTPUT_TOKENS=2000
AUDIT_VISION_PRICE_INPUT_PER_MTOK=
AUDIT_VISION_PRICE_OUTPUT_PER_MTOK=
# 0 = always call the model instead of reusing cache/vision_llm_cache.json
AUDIT_VISION_CACHE=1


# ---------------------------------------------------------------------------------------------------------------------
# 5. Reviewer agent  (audit-reviewer-agent; one call per deletion request; opt-in; never changes output.csv)
# ---------------------------------------------------------------------------------------------------------------------
AUDIT_REVIEW_ENABLED=false
AUDIT_REVIEW_MODEL=anthropic/claude-sonnet-5-5
AUDIT_REVIEW_API_KEY=
AUDIT_REVIEW_BASE_URL=
AUDIT_REVIEW_TEMPERATURE=0
AUDIT_REVIEW_MAX_OUTPUT_TOKENS=1000
AUDIT_REVIEW_PRICE_INPUT_PER_MTOK=
AUDIT_REVIEW_PRICE_OUTPUT_PER_MTOK=


# ---------------------------------------------------------------------------------------------------------------------
# 6. Data location (optional)
# ---------------------------------------------------------------------------------------------------------------------
# Defaults to ../dataset next to code/. Point at another copy with the same layout (used by the custom eval cases).
DATASET_DIR=


# ---------------------------------------------------------------------------------------------------------------------
# Example mixes (uncomment one block, keep the matching provider key above)
# ---------------------------------------------------------------------------------------------------------------------
# All Anthropic (defaults):        ANTHROPIC_API_KEY=...
#
# Mixed providers:
# AUDIT_INTENT_MODEL=openai/gpt-5-mini            # cheap text classifier      -> OPENAI_API_KEY
# AUDIT_VISION_MODEL=anthropic/claude-sonnet-5-5  # strong multimodal reader   -> ANTHROPIC_API_KEY
# AUDIT_REVIEW_MODEL=google/gemini-2.5-pro        # independent reviewer       -> GOOGLE_GENERATIVE_AI_API_KEY
# AUDIT_REVIEW_ENABLED=true
#
# Local / self-hosted OpenAI-compatible server for the intent agent only (no cloud key needed for that agent):
# AUDIT_INTENT_MODEL=openai/llama3.1:8b
# AUDIT_INTENT_BASE_URL=http://localhost:11434/v1
# AUDIT_INTENT_API_KEY=local-placeholder
# AUDIT_INTENT_PRICE_INPUT_PER_MTOK=0
# AUDIT_INTENT_PRICE_OUTPUT_PER_MTOK=0
